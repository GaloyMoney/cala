  "query": "\n            SELECT c.latest_values AS \"values!\", a.normal_balance_type AS \"normal_balance_type!: DebitOrCredit\"\n            FROM cala_current_balances c\n            JOIN cala_accounts a\n            ON c.account_id = a.id\n            WHERE c.journal_id = $1\n            AND c.account_id = $2\n            AND c.currency = $3\n            ",
