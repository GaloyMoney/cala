  "query": "WITH entities AS (SELECT name, id FROM cala_account_sets ORDER BY name DESC, id DESC LIMIT $1) SELECT i.id AS \"entity_id: Repo__Id\", e.sequence, e.event, CASE WHEN $2 THEN e.context ELSE NULL::jsonb END as \"context: es_entity::ContextData\", e.recorded_at, NULL::jsonb as \"forgettable_payload?\" FROM entities i JOIN cala_account_set_events e ON i.id = e.id ORDER BY i.name desc, i.id desc, i.id, e.sequence",
