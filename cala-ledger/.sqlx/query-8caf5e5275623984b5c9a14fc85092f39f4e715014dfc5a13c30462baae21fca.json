  "query": "\n            SELECT calculation_id AS \"calculation_id: CalculationId\",\n                   account_id AS \"account_id: AccountId\",\n                   activation_sequence,\n                   backfill_complete,\n                   created_at\n            FROM cala_calculation_attachments\n            WHERE calculation_id = $1\n              AND ($2::uuid IS NULL OR account_id > $2)\n            ORDER BY account_id\n            LIMIT $3\n            ",
