{
  "db_name": "PostgreSQL",
  "query": "WITH entities AS (SELECT id FROM cala_entries WHERE account_id = $1 AND journal_id = $2 AND (id > $4) ORDER BY id ASC LIMIT $3) SELECT i.id AS \"entity_id: Repo__Id\", e.sequence, e.event, CASE WHEN $5 THEN e.context ELSE NULL::jsonb END as \"context: es_entity::ContextData\", e.recorded_at, NULL::jsonb as \"forgettable_payload?\" FROM entities i JOIN cala_entry_events e ON i.id = e.id ORDER BY i.id asc, i.id, e.sequence",
