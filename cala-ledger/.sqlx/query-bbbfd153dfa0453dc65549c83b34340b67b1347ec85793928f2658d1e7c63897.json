  "query": "\n            SELECT sequence AS \"sequence!: i64\", id AS \"id!\", payload, tracing_context, recorded_at AS \"recorded_at!\"\n            FROM cala_persistent_outbox_events\n            WHERE sequence > $1\n              AND sequence <= $1 + $2\n            ORDER BY sequence ASC\n            LIMIT $2",
