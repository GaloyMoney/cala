  "query": "WITH entities AS (SELECT journal_id, created_at, id FROM cala_calculations WHERE journal_id = ANY($1) ORDER BY journal_id, created_at ASC, id ASC) SELECT i.id AS \"entity_id!: Repo__Id\", e.sequence, e.event, CASE WHEN $2 THEN e.context ELSE NULL::jsonb END as \"context: es_entity::ContextData\", e.recorded_at, NULL::jsonb as \"forgettable_payload?\" FROM entities i JOIN cala_calculation_events e ON i.id = e.id ORDER BY i.journal_id, i.created_at asc, i.id asc, i.id, e.sequence",
