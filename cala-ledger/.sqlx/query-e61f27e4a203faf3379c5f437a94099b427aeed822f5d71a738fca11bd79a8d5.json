  "db_name": "PostgreSQL",
  "query": "WITH entities AS (\n            SELECT l.created_at, l.id\n            FROM cala_velocity_limits l\n            JOIN cala_velocity_control_limits c ON c.velocity_limit_id = l.id\n            WHERE c.velocity_control_id = $1\n            ORDER BY l.created_at, l.id) SELECT i.id AS \"entity_id!: Repo__Id\", e.sequence, e.event, CASE WHEN $2 THEN e.context ELSE NULL::jsonb END as \"context: es_entity::ContextData\", e.recorded_at, NULL::jsonb as \"forgettable_payload?\" FROM entities i JOIN cala_velocity_limit_events e ON i.id = e.id ORDER BY i.created_at, i.id, i.id, e.sequence",
