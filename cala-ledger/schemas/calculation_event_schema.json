{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CalculationEvent",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "initialized"
        },
        "values": {
          "$ref": "#/$defs/CalculationValues"
        }
      },
      "required": [
        "type",
        "values"
      ]
    },
    {
      "description": "Global only. Rewrites `activation_sequence` to the tip checkpoint at handoff.",
      "type": "object",
      "properties": {
        "activation_sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "backfill_completed"
        }
      },
      "required": [
        "type",
        "activation_sequence"
      ]
    }
  ],
  "$defs": {
    "BackfillStatus": {
      "oneOf": [
        {
          "description": "History before `activation_sequence` is being folded in; the tip ignores this unit.",
          "type": "string",
          "const": "in_progress"
        },
        {
          "description": "Every entry is in the series (or the unit was created `FromNow`).",
          "type": "string",
          "const": "complete"
        }
      ]
    },
    "CalculationConfig": {
      "type": "object",
      "properties": {
        "effective_date_source": {
          "description": "CEL resolving to a date; the effective date the entry's delta lands on.\n`None` = the transaction's `effective`.",
          "anyOf": [
            {
              "$ref": "#/$defs/CelExpression"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CalculationScope": {
      "description": "Which accounts and sets of the journal a calculation maintains series for.",
      "oneOf": [
        {
          "description": "Every account and account set in the journal.",
          "type": "string",
          "const": "global"
        },
        {
          "description": "Only the accounts and sets explicitly attached to the calculation.",
          "type": "string",
          "const": "attached"
        }
      ]
    },
    "CalculationValues": {
      "type": "object",
      "properties": {
        "activation_sequence": {
          "description": "Outbox sequence at creation; the subscriber applies this calculation to\nevents with a greater sequence only.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "backfill_status": {
          "description": "Only meaningful for `Global` scope; `Attached` calculations are always `Complete`\nhere and carry status per attachment.",
          "$ref": "#/$defs/BackfillStatus"
        },
        "code": {
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/CelExpression"
            },
            {
              "type": "null"
            }
          ]
        },
        "config": {
          "$ref": "#/$defs/CalculationConfig"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartitionKey"
          }
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "journal_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/CalculationScope"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "version",
        "journal_id",
        "code",
        "name",
        "scope",
        "dimensions",
        "config",
        "activation_sequence",
        "backfill_status"
      ]
    },
    "CelExpression": {
      "type": "string"
    },
    "PartitionKey": {
      "type": "object",
      "properties": {
        "alias": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/CelExpression"
        }
      },
      "required": [
        "alias",
        "value"
      ]
    }
  }
}
